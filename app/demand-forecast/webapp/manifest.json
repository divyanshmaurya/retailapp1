{
  "_version": "1.59.0",
  "sap.app": {
    "id": "smart.retail.demandforecast",
    "type": "application",
    "title": "Demand Forecast",
    "description": "Hourly demand forecast per store and article with prediction intervals",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/ai/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "demand-forecast-inbound": {
          "semanticObject": "DemandForecast",
          "action": "display",
          "title": "Demand Forecast",
          "subTitle": "Hourly demand",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smart.retail.demandforecast.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "DemandForecastsList",
          "target": "DemandForecastsList"
        },
        {
          "pattern": "DemandForecasts({key}):?query:",
          "name": "DemandForecastsDetail",
          "target": "DemandForecastsDetail"
        }
      ],
      "targets": {
        "DemandForecastsList": {
          "type": "Component",
          "id": "DemandForecastsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/DemandForecasts",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "DemandForecasts": {
                  "detail": {
                    "route": "DemandForecastsDetail"
                  }
                }
              }
            }
          }
        },
        "DemandForecastsDetail": {
          "type": "Component",
          "id": "DemandForecastsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/DemandForecasts",
              "editableHeaderContent": false
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "flexEnabled": true
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
