{
  "_version": "1.59.0",
  "sap.app": {
    "id": "smart.retail.insightfeed",
    "type": "application",
    "title": "AI Insight Feed",
    "description": "Every scenario in one queue, ranked by value at stake",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/ai/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "insight-feed-inbound": {
          "semanticObject": "AIInsight",
          "action": "display",
          "title": "AI Insight Feed",
          "subTitle": "All scenarios",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smart.retail.insightfeed.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AIInsightsList",
          "target": "AIInsightsList"
        },
        {
          "pattern": "AIInsights({key}):?query:",
          "name": "AIInsightsDetail",
          "target": "AIInsightsDetail"
        }
      ],
      "targets": {
        "AIInsightsList": {
          "type": "Component",
          "id": "AIInsightsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/AIInsights",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "AIInsights": {
                  "detail": {
                    "route": "AIInsightsDetail"
                  }
                }
              }
            }
          }
        },
        "AIInsightsDetail": {
          "type": "Component",
          "id": "AIInsightsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/AIInsights",
              "editableHeaderContent": false
            }
          }
        }
      },
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "controlAggregation": "beginColumnPages",
        "controlId": "appRootView",
        "transition": "slide",
        "async": true
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "flexEnabled": true
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
