{
  "_version": "1.59.0",
  "sap.app": {
    "id": "smart.retail.checkoutintegrity",
    "type": "application",
    "title": "Checkout Integrity Radar",
    "description": "RFID misreads, absent tags, stock variance and price errors on the autonomous checkout terminals",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/ai/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "checkout-integrity-inbound": {
          "semanticObject": "ShrinkAlert",
          "action": "display",
          "title": "Checkout Integrity Radar",
          "subTitle": "Autonomous loss prevention",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smart.retail.checkoutintegrity.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ShrinkAlertsList",
          "target": "ShrinkAlertsList"
        },
        {
          "pattern": "ShrinkAlerts({key}):?query:",
          "name": "ShrinkAlertsDetail",
          "target": "ShrinkAlertsDetail"
        }
      ],
      "targets": {
        "ShrinkAlertsList": {
          "type": "Component",
          "id": "ShrinkAlertsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ShrinkAlerts",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "ShrinkAlerts": {
                  "detail": {
                    "route": "ShrinkAlertsDetail"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "open",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Open"
                  },
                  {
                    "key": "all",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#All"
                  }
                ]
              }
            }
          }
        },
        "ShrinkAlertsDetail": {
          "type": "Component",
          "id": "ShrinkAlertsDetail",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ShrinkAlerts",
              "editableHeaderContent": false
            }
          }
        }
      },
      "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "controlAggregation": "beginColumnPages",
        "controlId": "appRootView",
        "transition": "slide",
        "async": true
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "flexEnabled": true
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
}
